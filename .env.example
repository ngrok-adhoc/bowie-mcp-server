# Required for ngrok OAuth.
NGROK_AUTHTOKEN=
USERS='["you@example.com"]'

# Optional HTTPS origin for your ngrok development domain or a custom domain.
# NGROK_URL=

# Private upstream for just oauth. Compose uses its own internal Bowie address.
# MCP_SERVER_URL=http://127.0.0.1:3001/mcp

# Extra private HTTP hostnames for just mcp, as a JSON list. Loopback is always allowed.
# ALLOWED_HOSTS='["bowie.internal"]'

# Optional OAuth consent branding.
# For Just, use a path relative to this repo. Compose mounts the bundled icon.
# MCP_SERVER_NAME=Bowie
# MCP_SERVER_ICON=./bowie-icon.png

# Optional published client identity for hosted Claude and Codex. DCR still works.
# CLAUDE_CIMD=1
